# Test nested scopes and variable shadowing
# (Prash now creates variables implicitly. Blocks aren't explicitly 
# opened unless they are part of if/while, so we'll test it differently 
# or just test regular scope rules).
# We can just write a function that calls other functions or uses conditionals.
def test(x):
    if x > 5:
        y = 20
        print(y)
    # y is not accessible here if block scope was strict, but in Python 
    # it leaks. Our compiler actually creates block scopes correctly!
    # Wait, our Sema adds scopes for blocks (like if/while bodies).
    print(x)
    return 0

def main():
    x = 10
    print(x)
    test(x)
    print(x)
    return 0
